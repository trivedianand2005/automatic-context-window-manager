# Copy to .env and adjust. Never commit a real .env file.
# Every variable is optional; ACWM runs fully offline with the defaults.

# Extra directories that may be indexed, separated by ";" on Windows or ":" on macOS/Linux.
# The ACWM project directory (which contains examples/) is always allowed.
ACWM_ALLOWED_ROOTS=

# Token budgeting (tiktoken encoding: cl100k_base, o200k_base or p50k_base)
ACWM_TOKEN_BUDGET=8000
ACWM_RESERVED_RESPONSE_TOKENS=1500
ACWM_TOKENIZER_ENCODING=cl100k_base

# Indexing limits
ACWM_MAX_FILE_BYTES=1000000
ACWM_MAX_FILES=5000

# Optional LLM provider: "none" (default) or "anthropic" (requires `pip install anthropic`)
ACWM_LLM_PROVIDER=none
ACWM_LLM_MODEL=claude-opus-5-5
# Placeholder: paste your key after the "=" (leave empty to disable).
ANTHROPIC_API_KEY=
# Conversation manager settings (models, thresholds, prices) live in config.yaml.
# Point this at another YAML file to switch configurations.
# ACWM_CONFIG=config.yaml
# true = allow live (billed) conversation benchmark runs from the API / web app.
ACWM_CONVERSATION_LIVE=false

# Optional TinyFish documentation research (mock provider is used when the key is empty)
ACWM_TINYFISH_ENABLED=false
# Placeholder: paste your key after the "=" (leave empty to use the offline mock).
TINYFISH_API_KEY=
ACWM_TINYFISH_INCLUDE_DOMAINS=fastapi.tiangolo.com,docs.pydantic.dev,docs.python.org

# Accounts and saved packages
# PostgreSQL in production (e.g. postgresql://user:pass@host:5432/db). When empty, a local
# SQLite file (.acwm/acwm.db) is used.
DATABASE_URL=
# Long random string that signs login tokens. Set it in production, otherwise tokens stop
# working whenever the server restarts.
ACWM_JWT_SECRET=
# true = every API request that does real work needs a logged-in user.
ACWM_REQUIRE_AUTH=false
# Where the browser goes after "Login with GitHub", and this API's public URL.
ACWM_FRONTEND_URL=http://localhost:5173
ACWM_PUBLIC_API_URL=http://127.0.0.1:8000
# Optional GitHub OAuth app (callback URL: <ACWM_PUBLIC_API_URL>/auth/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
